{
  "name": "express-todo",
  "version": "1.0.0",
  "description": "Simple to-do list app with Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:ui": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test test/**/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "supertest": "^7.0.0",
    "vite": "^6.3.5"
  }
}
